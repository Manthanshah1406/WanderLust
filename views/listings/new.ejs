<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wanderlust</title>
</head>

<body>
    <h1>Create new Listing</h1>
    <form action="/listings" method="post">
        Title: <input type="text" name="title" placeholder="Enter your title" /><br />
        Description: <textarea name="description" placeholder="Enter your description" /></textarea><br />
        Image Url: <input type="text" name="image" placeholder="Enter your image url" /><br />
        Price: <input type="Number" name="price" placeholder="Enter your price" /><br />
        Location: <input type="text" name="location" placeholder="Enter your location" /><br />
        Country: <input type="text" name="country" placeholder="Enter your country" /><br />
        <button type="submit">Add</button>
    </form>
</body>

</html>