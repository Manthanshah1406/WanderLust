<% layout('/layouts/boilerplate') %>

    <div class="row mt-3">
        <div class="col-8 offset-3">
            <h1>Listing Details</h1>
        </div>

        <div class="card col-6 offset-3 show-card">
            <img src="<%= List.image.url %>" class="card-img-top show-img" alt="listing_image">
            <div class="card-body">
                <p class="card-text">
                    <b>
                        <%= List.title %>
                    </b> <br>
                    <%= List.description %> <br>
                        &#8377; <%= List.price.toLocaleString("en-IN") %> <br>
                            <%= List.location %><br>
                                <%= List.country %><br>
                </p>
            </div>
        </div>
        <br>
        <div class="btns">
            <a href="/listings/<%= List._id %>/edit" class="btn btn-dark edit-btn col-1 offset-3">Edit</a> <br>

            <form method="post" action="/listings/<%= List._id %>?_method=DELETE">
                <button class="btn btn-dark delete-btn offset-5">DELETE</button>
            </form>
        </div>
    </div>

    <br><br><br>